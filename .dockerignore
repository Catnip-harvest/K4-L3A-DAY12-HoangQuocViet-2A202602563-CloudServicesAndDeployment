# Những thứ KHÔNG được vào build context / image.
# Image chỉ cần: requirements.txt, app/, utils/ — đừng bao giờ ignore chúng.

# Secrets
.env
.env.*
*.pem
*.key

# Git & CI
.git
.gitignore
.github

# Python artefacts
**/__pycache__
**/*.pyc
.pytest_cache
.venv
venv
env

# Không cần lúc chạy
tests
screenshots
solution
*.md
*.log
Dockerfile.single
docker-compose*.yml
nginx
render.yaml
railway.toml
grade.py

# OS / editor
.DS_Store
Thumbs.db
.idea
.vscode
